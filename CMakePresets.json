{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
            }
        },

        {
            "name": "windows-x64-release",
            "inherits": "default",
            "displayName": "libslicer · Windows · x64 · Release",
            "binaryDir": "${sourceDir}/build-libslicer/release/x64",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset":      { "value": "host=x64", "strategy": "external" }
        },
        {
            "name": "windows-x64-debug",
            "inherits": "windows-x64-release",
            "displayName": "libslicer · Windows · x64 · Debug",
            "binaryDir": "${sourceDir}/build-libslicer/debug/x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
            "name": "linux-release",
            "inherits": "default",
            "displayName": "libslicer · Linux · Release",
            "binaryDir": "${sourceDir}/build-libslicer/release/linux",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "linux-release",
            "displayName": "libslicer · Linux · Debug",
            "binaryDir": "${sourceDir}/build-libslicer/debug/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
            "name": "macos-arm64-release",
            "inherits": "default",
            "displayName": "libslicer · macOS · arm64 · Release",
            "binaryDir": "${sourceDir}/build-libslicer/release/arm64",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.3",
                "CMAKE_IGNORE_PREFIX_PATH": "/opt/local;/usr/local;/opt/homebrew"
            }
        },
        {
            "name": "macos-arm64-debug",
            "inherits": "macos-arm64-release",
            "displayName": "libslicer · macOS · arm64 · Debug",
            "binaryDir": "${sourceDir}/build-libslicer/debug/arm64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
            "name": "macos-x86_64-release",
            "inherits": "default",
            "displayName": "libslicer · macOS · x86_64 · Release",
            "binaryDir": "${sourceDir}/build-libslicer/release/x86_64",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.3",
                "CMAKE_IGNORE_PREFIX_PATH": "/opt/local;/usr/local;/opt/homebrew"
            }
        },
        {
            "name": "macos-x86_64-debug",
            "inherits": "macos-x86_64-release",
            "displayName": "libslicer · macOS · x86_64 · Debug",
            "binaryDir": "${sourceDir}/build-libslicer/debug/x86_64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-x64-release",  "configurePreset": "windows-x64-release",  "targets": [ "libslicer" ] },
        { "name": "windows-x64-debug",    "configurePreset": "windows-x64-debug",    "targets": [ "libslicer" ] },
        { "name": "linux-release",        "configurePreset": "linux-release",        "targets": [ "libslicer" ] },
        { "name": "linux-debug",          "configurePreset": "linux-debug",          "targets": [ "libslicer" ] },
        { "name": "macos-arm64-release",  "configurePreset": "macos-arm64-release",  "targets": [ "libslicer" ] },
        { "name": "macos-arm64-debug",    "configurePreset": "macos-arm64-debug",    "targets": [ "libslicer" ] },
        { "name": "macos-x86_64-release", "configurePreset": "macos-x86_64-release", "targets": [ "libslicer" ] },
        { "name": "macos-x86_64-debug",   "configurePreset": "macos-x86_64-debug",   "targets": [ "libslicer" ] }
    ]
}
