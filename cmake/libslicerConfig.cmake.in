@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/libslicerTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/libslicerPrivateArchives.cmake")

set(_libslicer_private_archive_dir
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libslicer/private")
foreach(_libslicer_private_archive IN LISTS _libslicer_private_archive_names)
    set_property(TARGET libslicer::sdk_v1 APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES
        "${_libslicer_private_archive_dir}/${_libslicer_private_archive}")
endforeach()
unset(_libslicer_private_archive)
unset(_libslicer_private_archive_dir)
unset(_libslicer_private_archive_names)

check_required_components(libslicer)
