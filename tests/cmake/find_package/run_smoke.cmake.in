set(_source_dir "@CMAKE_CURRENT_SOURCE_DIR@/cmake/find_package")
set(_build_dir "@CMAKE_CURRENT_BINARY_DIR@/cmake/find_package-build")
set(_install_prefix "@CMAKE_CURRENT_BINARY_DIR@/cmake/find_package-install")

if(NOT DEFINED LIBSLICER_SMOKE_CONFIG OR LIBSLICER_SMOKE_CONFIG STREQUAL "")
    set(LIBSLICER_SMOKE_CONFIG "@CMAKE_BUILD_TYPE@")
endif()

file(REMOVE_RECURSE "${_build_dir}" "${_install_prefix}")

set(_build_args
    --build "@CMAKE_BINARY_DIR@"
    --target libslicer_sdk_v1
)
if(NOT LIBSLICER_SMOKE_CONFIG STREQUAL "")
    list(APPEND _build_args --config "${LIBSLICER_SMOKE_CONFIG}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" ${_build_args}
    RESULT_VARIABLE _build_sdk_result
)
if(NOT _build_sdk_result EQUAL 0)
    message(FATAL_ERROR "libslicer SDK build failed before find_package smoke")
endif()

set(_install_args
    --install "@CMAKE_BINARY_DIR@"
    --prefix "${_install_prefix}"
)
if(NOT LIBSLICER_SMOKE_CONFIG STREQUAL "")
    list(APPEND _install_args --config "${LIBSLICER_SMOKE_CONFIG}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" ${_install_args}
    RESULT_VARIABLE _install_result
)
if(NOT _install_result EQUAL 0)
    message(FATAL_ERROR "libslicer install failed before find_package smoke")
endif()

file(GLOB_RECURSE _installed_headers
    RELATIVE "${_install_prefix}"
    "${_install_prefix}/@CMAKE_INSTALL_INCLUDEDIR@/*")
set(_expected_headers
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Config.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/ConfigSchema.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Context.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Preset.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Project.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Result.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Slice.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/Version.hpp"
    "@CMAKE_INSTALL_INCLUDEDIR@/libslicer/v1/json.hpp")
list(SORT _installed_headers)
list(SORT _expected_headers)
if(NOT _installed_headers STREQUAL _expected_headers)
    message(FATAL_ERROR
        "Default install contains headers outside the v1 public surface: ${_installed_headers}")
endif()

file(GLOB _installed_cmake_packages
    RELATIVE "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake"
    "${_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/*")
if(NOT _installed_cmake_packages STREQUAL "libslicer")
    message(FATAL_ERROR
        "Default install contains non-libslicer CMake packages: ${_installed_cmake_packages}")
endif()

set(_configure_args
    -S "${_source_dir}"
    -B "${_build_dir}"
    -G "@CMAKE_GENERATOR@"
    "-DCMAKE_PREFIX_PATH=${_install_prefix}"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
)

if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "")
    list(APPEND _configure_args "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@")
endif()

if(NOT "@CMAKE_OSX_ARCHITECTURES@" STREQUAL "")
    list(APPEND _configure_args "-DCMAKE_OSX_ARCHITECTURES=@CMAKE_OSX_ARCHITECTURES@")
endif()

if(NOT "@CMAKE_OSX_DEPLOYMENT_TARGET@" STREQUAL "")
    list(APPEND _configure_args "-DCMAKE_OSX_DEPLOYMENT_TARGET=@CMAKE_OSX_DEPLOYMENT_TARGET@")
endif()

if(NOT "@CMAKE_OSX_SYSROOT@" STREQUAL "")
    list(APPEND _configure_args "-DCMAKE_OSX_SYSROOT=@CMAKE_OSX_SYSROOT@")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" ${_configure_args}
    RESULT_VARIABLE _configure_result
)
if(NOT _configure_result EQUAL 0)
    message(FATAL_ERROR "libslicer find_package smoke configure failed")
endif()

set(_consumer_build_args
    --build "${_build_dir}"
    --target run_libslicer_find_package_smoke
)
if(NOT LIBSLICER_SMOKE_CONFIG STREQUAL "")
    list(APPEND _consumer_build_args --config "${LIBSLICER_SMOKE_CONFIG}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" ${_consumer_build_args}
    RESULT_VARIABLE _consumer_build_result
)
if(NOT _consumer_build_result EQUAL 0)
    message(FATAL_ERROR "libslicer find_package smoke build/run failed")
endif()
